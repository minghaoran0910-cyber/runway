diff --git a/app/lib/ui/root_shell.dart b/app/lib/ui/root_shell.dart
new file mode 100644
index 0000000..b540a75
--- /dev/null
+++ b/app/lib/ui/root_shell.dart
@@ -0,0 +1,73 @@
+import 'package:flutter/material.dart';
+
+import '../data/app_db.dart';
+import 'category_page.dart';
+import 'goal_page.dart';
+import 'home_page.dart';
+import 'quick_add_page.dart';
+
+// SB-027 · 底部导航壳（P0 急救）：三 tab（首页/账本/我的），现有页面全挂进去.
+// 首页=HomePage（内层记一笔 FAB 让位外层统一 FAB）；账本=CategoryPage；
+// 我的=GoalPage（保留其定目标 FAB，该页外层记一笔 FAB 隐藏，偏差见提审单）.
+
+class RootShell extends StatefulWidget {
+  const RootShell({super.key, required this.db});
+
+  final AppDb db;
+
+  @override
+  State<RootShell> createState() => RootShellState();
+}
+
+class RootShellState extends State<RootShell> {
+  int index = 0;
+
+  Future<void> _openAdd() async {
+    await Navigator.of(context).push<bool>(
+      MaterialPageRoute<bool>(builder: (_) => QuickAddPage(db: widget.db)),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      body: IndexedStack(
+        index: index,
+        children: <Widget>[
+          HomePage(db: widget.db, showFab: false),
+          CategoryPage(db: widget.db),
+          GoalPage(db: widget.db),
+        ],
+      ),
+      floatingActionButton: index == 2
+          ? null
+          : FloatingActionButton(
+              onPressed: _openAdd,
+              tooltip: '记一笔',
+              key: const Key('shellAdd'),
+              child: const Icon(Icons.add),
+            ),
+      bottomNavigationBar: NavigationBar(
+        selectedIndex: index,
+        onDestinationSelected: (int i) => setState(() => index = i),
+        destinations: const <Widget>[
+          NavigationDestination(
+            icon: Icon(Icons.home_outlined),
+            selectedIcon: Icon(Icons.home),
+            label: '首页',
+          ),
+          NavigationDestination(
+            icon: Icon(Icons.book_outlined),
+            selectedIcon: Icon(Icons.book),
+            label: '账本',
+          ),
+          NavigationDestination(
+            icon: Icon(Icons.person_outlined),
+            selectedIcon: Icon(Icons.person),
+            label: '我的',
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/app/test/root_shell_test.dart b/app/test/root_shell_test.dart
new file mode 100644
index 0000000..c389485
--- /dev/null
+++ b/app/test/root_shell_test.dart
@@ -0,0 +1,64 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:runway/data/app_db.dart';
+import 'package:runway/ui/root_shell.dart';
+
+// SB-027 · 底部导航三 tab 可达性：首页/账本/我的均可达，FAB 口径如卡.
+
+Widget _wrap(AppDb db) {
+  return MaterialApp(home: RootShell(db: db));
+}
+
+void _largeViewport(WidgetTester tester) {
+  tester.view.physicalSize = const Size(1080, 2400);
+  tester.view.devicePixelRatio = 1.0;
+  addTearDown(tester.view.resetPhysicalSize);
+}
+
+Future<void> _unmountAndFlush(WidgetTester tester) async {
+  await tester.pumpWidget(Container());
+  await tester.pump();
+  await tester.pump(const Duration(milliseconds: 100));
+  await tester.pump();
+  await tester.pump(const Duration(milliseconds: 100));
+  await tester.pump();
+}
+
+void main() {
+  testWidgets('SB-027 三 tab 可达 + FAB 口径', (WidgetTester tester) async {
+    _largeViewport(tester);
+    final AppDb db = AppDb.memoryForTest();
+
+    await tester.pumpWidget(_wrap(db));
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+
+    // 首页（默认）：攒够标题 + 统一记一笔 FAB.
+    expect(find.text('攒够'), findsOneWidget);
+    expect(find.byKey(const Key('shellAdd')), findsOneWidget);
+
+    // 账本：类目管理页可达 + 统一 FAB 仍在.
+    await tester.tap(find.text('账本'));
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(find.text('类目管理'), findsOneWidget);
+    expect(find.byKey(const Key('shellAdd')), findsOneWidget);
+
+    // 我的：目标阶梯页可达；该页保留定目标 FAB，外层记一笔隐藏.
+    await tester.tap(find.text('我的'));
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(find.text('目标阶梯'), findsOneWidget);
+    expect(find.byKey(const Key('goalAdd')), findsOneWidget);
+    expect(find.byKey(const Key('shellAdd')), findsNothing);
+
+    // 回首页：统一 FAB 恢复.
+    await tester.tap(find.text('首页'));
+    await tester.pump(const Duration(milliseconds: 300));
+    await tester.pump();
+    expect(find.text('攒够'), findsOneWidget);
+    expect(find.byKey(const Key('shellAdd')), findsOneWidget);
+
+    await _unmountAndFlush(tester);
+  });
+}
diff --git a/app/test/text_scaler_test.dart b/app/test/text_scaler_test.dart
new file mode 100644
index 0000000..1318b97
--- /dev/null
+++ b/app/test/text_scaler_test.dart
@@ -0,0 +1,48 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:runway/main.dart';
+
+// SB-027 · 系统字体放大钳制回归：1.5 倍缩放不破版（统一压到 ≤1.3）.
+
+void main() {
+  test('SB-027 clampTextScaler：超 1.3 压平，不超原样', () {
+    expect(
+      clampTextScaler(const TextScaler.linear(2.0)).scale(10.0),
+      equals(13.0),
+    );
+    expect(
+      clampTextScaler(const TextScaler.linear(1.5)).scale(10.0),
+      equals(13.0),
+    );
+    expect(
+      clampTextScaler(const TextScaler.linear(1.3)).scale(10.0),
+      equals(13.0),
+    );
+    expect(
+      clampTextScaler(const TextScaler.linear(1.0)).scale(10.0),
+      equals(10.0),
+    );
+    expect(clampTextScaler(TextScaler.noScaling).scale(10.0), equals(10.0));
+  });
+
+  testWidgets('SB-027 builder：1.5 缩放进入后 ≤1.3', (WidgetTester tester) async {
+    TextScaler? seen;
+    await tester.pumpWidget(
+      MediaQuery(
+        data: const MediaQueryData(textScaler: TextScaler.linear(1.5)),
+        child: MaterialApp(
+          builder: textClampBuilder,
+          home: Builder(
+            builder: (BuildContext ctx) {
+              seen = MediaQuery.textScalerOf(ctx);
+              return const SizedBox.shrink();
+            },
+          ),
+        ),
+      ),
+    );
+    await tester.pump();
+    expect(seen, isNotNull);
+    expect(seen!.scale(10.0), lessThanOrEqualTo(13.0));
+  });
+}
